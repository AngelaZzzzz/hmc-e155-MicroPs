# Pin assignments from Jacquard FPGA Studio.
# Edit this file, or the pin table on the Build screen: they are two views of one thing.
# Uploading the .zip this came in restores the pins, the board and the design top.
# jacquard-board: upduino-v3.1
# jacquard-top: counter
set_io -nowarn -pullup yes -pullup_resistor 100K col[0] 6
set_io -nowarn -pullup yes -pullup_resistor 100K col[1] 21
set_io -nowarn -pullup yes -pullup_resistor 100K col[2] 20
set_io -nowarn -pullup yes -pullup_resistor 100K col[3] 10
set_io -nowarn led[0] 28
set_io -nowarn led[1] 38
set_io -nowarn led[2] 42
set_io -nowarn led[3] 27
set_io -nowarn pnp[0] 46
set_io -nowarn pnp[1] 45
set_io -nowarn -pullup yes -pullup_resistor 100K reset 34
set_io -nowarn row[0] 19
set_io -nowarn row[1] 11
set_io -nowarn row[2] 3
set_io -nowarn row[3] 44
set_io -nowarn seg[0] 18
set_io -nowarn seg[1] 9
set_io -nowarn seg[2] 47
set_io -nowarn seg[3] 48
set_io -nowarn seg[4] 4
set_io -nowarn seg[5] 13
set_io -nowarn seg[6] 12
